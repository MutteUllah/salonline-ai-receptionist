# Run npm run setup to generate local secrets. Never commit your .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/salonline.sqlite
SALON_TIME_ZONE=Asia/Karachi
# Production requires PostgreSQL. No sslmode=no-verify in production.
DATABASE_URL=
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=
SESSION_SECRET=

# Add these only when enabling real calls; never enter keys in the browser.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Meta-approved utility template: variables 1 customer, 2 service,
# 3 date/time, 4 booking reference, 5 status. See docs/OPERATIONS.md.
WHATSAPP_CONTENT_SID=
# Explicit operator opt-in; all messages queued until enabled.
WHATSAPP_SEND_ENABLED=false
MAX_CONCURRENT_CALLS=10
MAX_CALL_SECONDS=600
